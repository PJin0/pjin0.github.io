<ul class="about-timeline">
  {% for item in site.data.awards %}
    <li class="timeline-item">
      <span class="timeline-date">{{ item.year }}</span>
      <div class="timeline-body">
        <span class="timeline-role">{{ item.title }}</span>
        {% if item.org %}
          <span class="timeline-sep">&middot;</span>
          <span class="timeline-org">{{ item.org }}</span>
        {% endif %}
        {% if item.note %}
          <div class="timeline-note">{{ item.note }}</div>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
